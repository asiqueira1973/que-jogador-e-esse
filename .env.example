# Variáveis de ambiente lidas pelo projeto. Nenhuma é segredo; a segurança vem das regras do
# Realtime Database. A configuração pública do Firebase fica em pwa-convidado/config.js e
# tvos-app/Resources/FirebaseConfig.plist.

# Harness do motor (tools/EngineHarness) e app tvOS: "0" ou "false" fala com o Firebase real;
# ausente, usa o emulador (ou a flag USAR_EMULADOR do plist, no app).
QJE_USAR_EMULADOR=

# Endereço do emulador do Realtime Database nos testes de regras. Normalmente definido
# automaticamente por `firebase emulators:exec` (ex.: 127.0.0.1:9000).
FIREBASE_DATABASE_EMULATOR_HOST=
